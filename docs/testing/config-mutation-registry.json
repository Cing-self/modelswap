{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OKIT configuration mutation registry",
  "version": 4,
  "status": "design-gate-only",
  "contract": {
    "writerSet": "entries where kind is writer",
    "setEquality": ["discoveredWriterIds", "registryWriterIds", "schemaIds", "raceIds"],
    "nativeOnlyRule": "native-only-no-write entries have no schemaId or raceId and must prove no user.json persistence",
    "invalidInputRule": "reject before fs read or write; user.json byte sequence remains unchanged",
    "privateAllowPoints": ["src/infrastructure/sync-config-store.js"],
    "cloudSyncCoreBoundary": "cloud-sync-core is composition only: it exports registered semantic operations and may not expose writeTail, generic mutation, replace, callback or snapshot APIs",
    "forbiddenImports": ["infrastructure generic mutation APIs", "cloud-sync-core generic mutation APIs", "config/user generic write facades"],
    "discovery": {
      "roots": ["src/application", "src/web/api", "src/commands", "src/config", "src/providers/adapters", "src/infrastructure"],
      "include": [
        "calls to a config-store or cloud-sync-core export",
        "calls to config/user write exports",
        "direct user.json write/rename/atomic-write calls",
        "functions receiving a user-config snapshot and persisting it",
        "adapter/configuration service persistence hooks"
      ],
      "exclude": [
        "src/web/frontend/**",
        "tests/**",
        "dist/**",
        "test-only replaceConfigForTest implementation",
        "read-only loadConfig/loadUserConfig callsites",
        "native config writers, represented only by explicit native-only-no-write rows"
      ],
      "astRequirements": [
        "resolve CommonJS require bindings and ESM imports/exports",
        "resolve property calls through local aliases and destructuring",
        "report source module, exported symbol and callsite location for every discovered writer",
        "fail on an unresolved dynamic write target rather than excluding it"
      ]
    }
  },
