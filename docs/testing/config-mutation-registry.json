  "schemaRules": {
    "settings.sync-settings":{"type":"object","additionalProperties":false,"required":["key","value"],"properties":{"key":{"enum":["autoSync","syncPlatform","password"]},"value":{"oneOf":[{"type":"boolean"},{"type":"string","minLength":1,"maxLength":512}]}}},
    "settings.platform":{"$ref":"#/$defs/platformField"},
    "settings.onboarding-set":{"type":"object","additionalProperties":false,"required":["done"],"properties":{"done":{"const":true}}},
    "settings.onboarding-reset":{"type":"object","additionalProperties":false},
    "scheduler.dirty":{"type":"object","additionalProperties":false,"required":["scope","timestamp"],"properties":{"scope":{"enum":["secrets","providers","agentProviders","modelOverrides"]},"timestamp":{"$ref":"#/$defs/utcTimestamp"}}},
    "sync.push-success":{"type":"object","additionalProperties":false,"required":["machineId","remoteVersion","timestamp","sections"],"properties":{"machineId":{"$ref":"#/$defs/id"},"remoteVersion":{"type":"integer","minimum":1,"maximum":99},"timestamp":{"$ref":"#/$defs/utcTimestamp"},"sections":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["secrets","providers","agentProviders","modelOverrides"]}},"targets":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "sync.pull-provider-marker":{"$ref":"#/$defs/remoteMarker"},
