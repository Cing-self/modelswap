    "lan.enable":{"type":"object","additionalProperties":false,"properties":{"port":{"$ref":"#/$defs/port"}}},
    "lan.disable":{"type":"object","additionalProperties":false},
    "lan.rotate":{"type":"object","additionalProperties":false},
    "lan.pair":{"type":"object","additionalProperties":false,"required":["password","baseUrl","peerToken"],"properties":{"password":{"$ref":"#/$defs/secret"},"baseUrl":{"$ref":"#/$defs/lanUrl"},"peerToken":{"$ref":"#/$defs/token"}}},
    "lan.listener-port":{"type":"object","additionalProperties":false,"required":["expectedToken","port"],"properties":{"expectedToken":{"$ref":"#/$defs/token"},"port":{"$ref":"#/$defs/port"}}},
    "provider.delete":{"type":"object","additionalProperties":false,"required":["providerId"],"properties":{"providerId":{"$ref":"#/$defs/id"}}},
    "provider.switch":{"$ref":"#/$defs/agentBinding"},
