  "aToB": {
    "adapterRuntimeSource":{"agentsMetaModule":"src/providers/registry.ts#AGENTS_META","adaptersModule":"src/providers/registry.ts#getAdapters","expectedIds":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"],"assertion":"sort(AGENTS_META.ids) === sort(getAdapters().map(adapter => adapter.id)) === expectedIds"},
    "steps":[
      {"id":"A01","dependsOn":[],"participantId":"a-payload","source":"sync-service#syncPush","assert":{"payloadIncludes":["providerSites","vaultReferences","agentBindingPrimitives","modelOverridePrimitives"],"payloadExcludes":["modelsCache","platformProjection","nativeAgentFiles","userConfigSnapshot"]}},
      {"id":"A02","dependsOn":["A01"],"participantId":"b-decrypt","source":"sync-service#syncPull","assert":{"decodeOnly":"versioned payload primitives","rejects":["unknownSection","wholeConfig","wholeSync","wholeAgentMap","wholeOverrideMap"]}},
      {"id":"A03","dependsOn":["A02"],"participantId":"b-decode","source":"sync-service#syncPull","assert":{"operations":["sync.pull-provider-marker","sync.pull-agent-site","sync.pull-agent-active","sync.pull-model-override","sync.pull-model-override-delete"]}},
      {"id":"A04","dependsOn":["A03"],"participantId":"b-queue-live","source":"sync-config-store#writeTail","assert":{"queueFreshRead":true,"conflictCheck":"shouldApplyRemoteSection","writesOnly":"ownedPaths"}},
      {"id":"A05","dependsOn":["A04"],"participantId":"b-provider-sites","source":"sync-provider-sites#mergeRemoteProviderSites","assert":{"providerSitesWritten":true,"modelsCacheWritten":false,"userConfigContainsModels":false}},
      {"id":"A06","dependsOn":["A05"],"participantId":"b-vault","source":"vault/store#VaultStore","assert":{"resolves":"local vault references","secretOutput":false}},
      {"id":"A07","dependsOn":["A06"],"participantId":"b-hydrate","source":"provider-service#discoverMissingConfiguredModels","assert":{"cacheSource":["official-model-endpoint","native-cli"],"cacheInPayload":false,"forbiddenMembership":["staticFallback","directoryOnly"]}},
      {"id":"A08","dependsOn":["A07"],"participantId":"b-reconcile","source":"sync-agent-reconciliation#createPulledAgentReconciler","assert":{"requires":"resolved local model","userConfigWrites":0,"unresolved":"structured-per-agent-failure"}},
      {"id":"A09","dependsOn":["A08"],"participantId":"b-native-files","source":"AGENTS_META/getAdapters runtime dynamic set","assert":{"nativeFileCount":10,"authProof":"non-secret reference/shape","secretOutput":false}},
      {"id":"A10","dependsOn":["A09"],"participantId":"b-offline","source":"model-discovery-service","assert":{"conditions":["offline","empty","invalidCredentials"],"preserves":["desiredState","nonemptyLocalCache"],"forbids":["blindNativeWrite","staticFallback","directoryOnly"]}}
    ]
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "platformId":{"enum":["cloudflare","cloudflare-kv","cloudflare-d1","cloudflare-r2","supabase","volcengine","webdav","lan","icloud"]},
    "utcTimestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"},
    "port":{"type":"integer","minimum":1,"maximum":65535},
    "token":{"type":"string","pattern":"^[A-Za-z0-9._~-]{16,512}$"},
    "secret":{"type":"string","minLength":1,"maxLength":512},
    "lanUrl":{"type":"string","pattern":"^https?://[^/@?#:]+(?::[0-9]{1,5})?(?:/[^?#]*)?$","maxLength":512},
    "platformField":{"type":"object","additionalProperties":false,"required":["platformId","field","value"],"properties":{"platformId":{"$ref":"#/$defs/platformId"},"field":{"type":"string"},"value":{}},"oneOf":[{"properties":{"platformId":{"const":"cloudflare"},"field":{"enum":["enabled","apiToken","storeId"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"cloudflare-kv"},"field":{"enum":["enabled","apiToken","storeId"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"cloudflare-d1"},"field":{"enum":["enabled","apiToken","databaseId","tableName"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"cloudflare-r2"},"field":{"enum":["enabled","accountId","r2AccessKeyId","r2SecretAccessKey","bucketName"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"supabase"},"field":{"enum":["enabled","projectId","apiKey"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"volcengine"},"field":{"enum":["enabled","region","accessKey","secretKey"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/secret"},{"$ref":"#/$defs/id"}]}}},{"properties":{"platformId":{"const":"webdav"},"field":{"enum":["enabled","url","username","password"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/webdavUrl"},{"$ref":"#/$defs/secret"}]}}},{"properties":{"platformId":{"const":"lan"},"field":{"enum":["enabled","baseUrl","token"]},"value":{"oneOf":[{"type":"boolean"},{"$ref":"#/$defs/lanUrl"},{"$ref":"#/$defs/token"}]}}},{"properties":{"platformId":{"const":"icloud"},"field":{"const":"enabled"},"value":{"type":"boolean"}}}]},
    "agentBinding":{"type":"object","additionalProperties":false,"required":["agentId","providerId","modelIds"],"properties":{"agentId":{"enum":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"]},"providerId":{"$ref":"#/$defs/id"},"modelIds":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"enabled":{"type":"boolean"},"activeModelId":{"$ref":"#/$defs/id"}}},
    "agentSiteDelete":{"type":"object","additionalProperties":false,"required":["agentId","providerId"],"properties":{"agentId":{"enum":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"]},"providerId":{"$ref":"#/$defs/id"}}},
    "agentSiteEnabled":{"type":"object","additionalProperties":false,"required":["agentId","providerId","enabled"],"properties":{"agentId":{"enum":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"]},"providerId":{"$ref":"#/$defs/id"},"enabled":{"const":false}}},
    "claudeTier":{"type":"object","additionalProperties":false,"required":["providerId","tier","modelId"],"properties":{"providerId":{"$ref":"#/$defs/id"},"tier":{"enum":["haiku","sonnet","opus"]},"modelId":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}}},
    "modelOverrideField":{"type":"object","additionalProperties":false,"required":["providerId","modelId","field","value"],"properties":{"providerId":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"},"field":{"type":"string"},"value":{}},"oneOf":[{"properties":{"field":{"enum":["name","description"]},"value":{"type":"string","minLength":1,"maxLength":512}}},{"properties":{"field":{"enum":["context","output"]},"value":{"type":"integer","minimum":1,"maximum":10000000}}},{"properties":{"field":{"enum":["reasoning","tool","structuredOutput","temperature"]},"value":{"type":"boolean"}}},{"properties":{"field":{"enum":["inputPrice","outputPrice"]},"value":{"type":"number","minimum":0,"maximum":1000000}}}]},
    "modelOverrideDelete":{"type":"object","additionalProperties":false,"required":["providerId","modelId"],"properties":{"providerId":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"}}},
    "remoteMarker":{"type":"object","additionalProperties":false,"required":["remoteVersion","remoteMachineId","target","timestamp"],"properties":{"remoteVersion":{"type":"integer","minimum":1,"maximum":99},"remoteMachineId":{"$ref":"#/$defs/id"},"target":{"$ref":"#/$defs/platformId"},"timestamp":{"$ref":"#/$defs/utcTimestamp"}}},
    "remoteAgentSite":{"type":"object","additionalProperties":false,"required":["remoteVersion","timestamp","agentId","providerId","modelIds"],"properties":{"remoteVersion":{"type":"integer","minimum":1,"maximum":99},"timestamp":{"$ref":"#/$defs/utcTimestamp"},"agentId":{"enum":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"]},"providerId":{"$ref":"#/$defs/id"},"modelIds":{"type":"array","minItems":1,"maxItems":16,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"enabled":{"type":"boolean"}}},
    "remoteAgentActive":{"type":"object","additionalProperties":false,"required":["remoteVersion","timestamp","agentId","providerId","modelId"],"properties":{"remoteVersion":{"type":"integer","minimum":1,"maximum":99},"timestamp":{"$ref":"#/$defs/utcTimestamp"},"agentId":{"enum":["claude","codex","opencode","openclaw","workbuddy","zcode","hermes","kimi-code","grok","mimo-code"]},"providerId":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"}}},
    "remoteOverrideField":{"type":"object","additionalProperties":false,"required":["remoteVersion","timestamp","providerId","modelId","field","value"],"properties":{"remoteVersion":{"type":"integer","minimum":1,"maximum":99},"timestamp":{"$ref":"#/$defs/utcTimestamp"},"providerId":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"},"field":{"type":"string"},"value":{}},"oneOf":[{"properties":{"field":{"enum":["name","description"]},"value":{"type":"string","minLength":1,"maxLength":512}}},{"properties":{"field":{"enum":["context","output"]},"value":{"type":"integer","minimum":1,"maximum":10000000}}},{"properties":{"field":{"enum":["reasoning","tool","structuredOutput","temperature"]},"value":{"type":"boolean"}}},{"properties":{"field":{"enum":["inputPrice","outputPrice"]},"value":{"type":"number","minimum":0,"maximum":1000000}}}]},
    "remoteOverrideDelete":{"type":"object","additionalProperties":false,"required":["remoteVersion","timestamp","providerId","modelId","delete"],"properties":{"remoteVersion":{"type":"integer","minimum":2,"maximum":99},"timestamp":{"$ref":"#/$defs/utcTimestamp"},"providerId":{"$ref":"#/$defs/id"},"modelId":{"$ref":"#/$defs/id"},"delete":{"const":true}}},
    "importPlatformField":{"type":"object","additionalProperties":false,"required":["password","platformId","field","value"],"properties":{"password":{"$ref":"#/$defs/secret"},"platformId":{"$ref":"#/$defs/platformId"},"field":{"enum":["enabled","storeId","apiToken","databaseId","tableName","accountId","r2AccessKeyId","r2SecretAccessKey","bucketName","projectId","apiKey","region","accessKey","secretKey","url","username","password","baseUrl","token"]},"value":{"type":["string","boolean"]}}},
    "legacyField":{"type":"object","additionalProperties":false,"required":["legacyVersion","retiredKey","decodedValue"],"properties":{"legacyVersion":{"type":"integer","minimum":1,"maximum":2},"retiredKey":{"enum":["providers","homeProviders","codexCatalogVisible","codexCatalogVisibleMigrated","claudeTierMaps","claude","agent","favoriteModels","recentModels","language"]},"decodedValue":{}},"oneOf":[{"properties":{"retiredKey":{"const":"language"},"decodedValue":{"enum":["zh","en",null]}}},{"properties":{"retiredKey":{"const":"codexCatalogVisibleMigrated"},"decodedValue":{"type":"boolean"}}},{"properties":{"retiredKey":{"enum":["providers","homeProviders","codexCatalogVisible","claudeTierMaps","claude","agent","favoriteModels","recentModels"]},"decodedValue":{"enum":["decoded-to-individual-operations","ignored-retired-key"]}}}]},
    "webdavUrl":{"type":"string","pattern":"^https?://[^/@?#:]+(?::[0-9]{1,5})?(?:/[^?#]*)?$","maxLength":512}
  }
