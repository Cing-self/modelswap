{
  "manifest_version": 3,
  "name": "MODELSWAP",
  "version": "2.0.7",
  "description": "MODELSWAP 密钥自动创建助手 — 复用 Chrome 已登录会话,一键自动创建 API Key 并回填 MODELSWAP vault",
  "permissions": ["debugger", "tabs", "cookies", "alarms", "scripting", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
